# PBS Mail / TMail environment example
# Copy values into your deployment environment or local .env.
# Do not commit real secrets.

# App
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
MAX_MESSAGES=20
MAX_LOGS=5000

# Admin
# Comma-separated admin emails allowed to open /admin.
ADMIN_EMAILS=admin@example.com
# Optional legacy/admin API key fallback for routes that accept x-admin-key.
ADMIN_API_KEY=

# Supabase browser client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase server/admin
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_KV_TABLE=app_kv
SUPABASE_TABLE_ALIASES=app_aliases
SUPABASE_TABLE_DOMAINS=app_domains
SUPABASE_TABLE_LOGS=app_logs
SUPABASE_TABLE_MESSAGES=app_messages
SUPABASE_TABLE_AUDIT=app_audit
SUPABASE_TABLE_API_KEYS=app_api_keys
SUPABASE_TABLE_PARTNER_ALIASES=app_partner_aliases
SUPABASE_TABLE_PARTNER_ACCESS_LOGS=app_partner_access_logs

# Cloudflare Email Worker inbound webhook
# Must match WEBHOOK_SECRET configured in Cloudflare Worker.
CLOUDFLARE_EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Gmail API fallback / legacy mode
# Optional when Cloudflare Email Worker is the primary inbox source.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GMAIL_PUBSUB_TOPIC=

# Optional file storage fallback when Supabase server env is not configured.
DATA_DIR=
TOKEN_PATH=
# 32 hex chars for AES-128 token encryption. Leave empty to store token plaintext.
TOKEN_ENCRYPTION_KEY=

# Partner API
PARTNER_API_ENABLED=true
PARTNER_KEY_PEPPER=replace-with-random-pepper
PARTNER_DEFAULT_RATE_LIMIT=60
PARTNER_MAX_WAIT_SECONDS=20

# Cloudflare Worker variables/secrets reference
# These are configured in Cloudflare Worker, not in the Next.js app.
# APP_WEBHOOK_URL=https://your-app.example.com/api/webhooks/cloudflare-email
# WEBHOOK_SECRET=replace-with-the-same-value-as-CLOUDFLARE_EMAIL_WEBHOOK_SECRET
# BACKUP_EMAIL=your-gmail-backup@gmail.com
